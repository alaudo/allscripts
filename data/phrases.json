        { "native": "잘 지내요", "ipa": "t͡ɕal t͡ɕi.nɛ.jo",              "latin": "Jal jinaeyo", "cyrillic": "чаль чинэё",      "translations": { "en": "I'm fine",              "ru": "У меня всё хорошо" } },
        { "native": "이름이 뭐예요?", "ipa": "i.ɾɯ.mi mwʌ.je.jo",          "latin": "Ireumi mwoyeyo?", "cyrillic": "ирыми мвоэё",  "translations": { "en": "What's your name?",     "ru": "Как вас зовут?" } },
        { "native": "제 이름은 …입니다", "ipa": "t͡ɕe i.ɾɯ.mɯn … im.ni.da",       "latin": "Je ireumeun … imnida", "cyrillic": "че ирымын … имнида","translations":{ "en": "My name is…",         "ru": "Меня зовут…" } },
        { "native": "이해 못 했어요", "ipa": "i.ɦɛ mo.tʰɛ.s͈ʌ.jo",          "latin": "Ihae mot haesseoyo", "cyrillic": "ихэ мот хэссоё","translations":{ "en": "I don't understand",    "ru": "Я не понимаю" } },
        { "native": "영어 할 줄 아세요?", "ipa": "jʌŋ.ʌ hal t͡ɕul a.se.jo",      "latin": "Yeongeo hal jul aseyo?", "cyrillic": "ёно халь чуль асэё","translations":{"en":"Do you speak English?","ru":"Вы говорите по-английски?"} },
        { "native": "얼마예요?", "ipa": "ʌl.ma.je.jo",              "latin": "Eolmayeyo?", "cyrillic": "ольмаэё",       "translations": { "en": "How much is it?",       "ru": "Сколько стоит?" } },
        { "native": "화장실이 어디예요?", "ipa": "hwa.d͡ʑaŋ.ɕi.ɾi ʌ.di.je.jo",      "latin": "Hwajangsiri eodiyeyo?", "cyrillic": "хваджансири одиэё","translations":{"en":"Where is the toilet?","ru":"Где туалет?"} },
        { "native": "도와주세요!", "ipa": "to.wa.d͡ʑu.se.jo",             "latin": "Dowajuseyo!", "cyrillic": "товаджусэё",      "translations": { "en": "Help!",                 "ru": "Помогите!" } },
