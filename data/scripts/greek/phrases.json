{
  "version": 3,
  "language": "Greek",
  "phrases": [
    {
      "native": "Γεια σας. Ευχαριστώ.",
      "latin": "Yia sas. Efcharistó.",
      "cyrillic": "я сас. эфхаристо",
      "translations": {
        "en": "Hello. Thank you.",
        "ru": "Здравствуйте. Спасибо."
      }
    },
    {
      "native": "Παρακαλώ. Συγγνώμη.",
      "latin": "Parakaló. Sygnómi.",
      "cyrillic": "паракало. сигноми",
      "translations": {
        "en": "Please. Excuse me.",
        "ru": "Пожалуйста. Извините."
      }
    },
    {
      "native": "Ναι. Όχι.",
      "latin": "Ne. Ochi.",
      "cyrillic": "нэ. охи",
      "translations": {
        "en": "Yes. No.",
        "ru": "Да. Нет."
      }
    },
    {
      "native": "Μιλάτε Αγγλικά;",
      "latin": "Miláte Angliká?",
