    { "glyph": "\u25CC\u064E", "ipa": "a", "latin": "a", "cyrillic": "а", "example": { "native": "كَتَبَ", "ipa": "kataba", "latin": "kataba", "cyrillic": "катаба", "meaning": "he wrote" }, "note": {"en": "Fatḥa — short /a/, a small slanted stroke above the consonant.", "ru": "Фатха — краткий /a/, маленький наклонный штрих над согласной."} },
    { "glyph": "\u25CC\u0650", "ipa": "i", "latin": "i", "cyrillic": "и", "example": { "native": "بِنْت", "ipa": "bint", "latin": "bint", "cyrillic": "бинт", "meaning": "girl" }, "note": {"en": "Kasra — short /i/, a small stroke below the consonant.", "ru": "Касра — краткий /i/, маленький штрих под согласной."} },
    { "glyph": "\u25CC\u064F", "ipa": "u", "latin": "u", "cyrillic": "у", "example": { "native": "كُتُب", "ipa": "kutub", "latin": "kutub", "cyrillic": "кутуб", "meaning": "books" }, "note": {"en": "Ḍamma — short /u/, a small ‘waw’ above the consonant.", "ru": "Дамма — краткий /u/, маленький значок в виде «вав» над согласной."} },
    { "glyph": "\u25CC\u0652", "ipa": "—", "latin": "—", "cyrillic": "—", "example": { "native": "اِبْن", "ipa": "ibn", "latin": "ibn", "cyrillic": "ибн", "meaning": "son" }, "note": {"en": "Sukūn — marks the absence of a vowel (consonant ends a syllable).", "ru": "Сукун — обозначает отсутствие гласного (согласная замыкает слог)."} },
    { "glyph": "\u25CC\u0651", "ipa": "(geminate)", "latin": "(double)", "cyrillic": "(удвоение)", "example": { "native": "سَيَّارَة", "ipa": "sajjaːra", "latin": "sayyāra", "cyrillic": "сайяра", "meaning": "car" }, "note": {"en": "Shadda — doubles (geminates) the consonant it sits over.", "ru": "Шадда — удваивает (геминирует) согласную, над которой стоит."} },
    { "glyph": "\u25CC\u064B", "ipa": "an", "latin": "an", "cyrillic": "ан", "example": { "native": "شُكْرًا", "ipa": "ʃukran", "latin": "shukran", "cyrillic": "шукран", "meaning": "thanks" }, "note": {"en": "Tanwīn fatḥ — indefinite accusative ending /-an/.", "ru": "Танвин фатх — окончание неопределённого винительного падежа /-an/."} },
    { "glyph": "\u25CC\u064D", "ipa": "in", "latin": "in", "cyrillic": "ин", "example": { "native": "بَيْتٍ", "ipa": "bajtin", "latin": "baytin", "cyrillic": "байтин", "meaning": "of a house" }, "note": {"en": "Tanwīn kasr — indefinite genitive ending /-in/.", "ru": "Танвин касра — окончание неопределённого родительного падежа /-in/."} },
    { "glyph": "\u25CC\u064C", "ipa": "un", "latin": "un", "cyrillic": "ун", "example": { "native": "بَيْتٌ", "ipa": "bajtun", "latin": "baytun", "cyrillic": "байтун", "meaning": "a house (nom.)" }, "note": {"en": "Tanwīn ḍamm — indefinite nominative ending /-un/.", "ru": "Танвин дамма — окончание неопределённого именительного падежа /-un/."} }
