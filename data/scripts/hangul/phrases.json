      }
    },
    {
      "native": "부탁합니다. 죄송합니다.",
      "latin": "Butakhamnida. Joesonghamnida.",
      "cyrillic": "путакхамнида. чвесонхамнида",
      "translations": {
        "en": "Please. Excuse me.",
        "ru": "Пожалуйста. Извините."
      }
    },
    {
